# 唯一權威來源：.kiro/steering/00-tech-stack.md §5
# （原文件引用「五人團隊分工與Spec開發建議書.md」第七章，該文件缺失，見 INDEX.md 已知缺口，
# 此清單已跟 AWS服務選型建議.md 第六節重複核對過，兩處一致，可直接採用）

AWS_REGION=us-west-2
BEDROCK_MODEL_ID=
BEDROCK_KNOWLEDGE_BASE_ID=
S3_DATA_BUCKET=
DECISION_LOG_TABLE=
USE_BEDROCK=true

# 開發期輔助（不在 00-tech-stack.md 原始清單，但 m5-api-orchestrator-dashboard/design.md
# 第2節「開發初期的stub介接」明確用到，一併記錄）：
USE_STUB_MODULES=false

# AWS 憑證由個人環境提供，不得寫入此檔案或 Git（00-tech-stack.md §5）。

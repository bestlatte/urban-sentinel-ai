# 唯一權威來源：.kiro/steering/00-tech-stack.md §5
# （原文件引用「五人團隊分工與Spec開發建議書.md」第七章，該文件缺失，見 INDEX.md 已知缺口，
# 此清單已跟 AWS服務選型建議.md 第六節重複核對過，兩處一致，可直接採用）
#
# 用法：複製成 .env 後填值。.env 已在 .gitignore，不會進版控。
#
# [2026-08-01] 這個檔案的值**現在真的會生效**了。在此之前全 repo 沒有任何一行
# 讀 .env（零 load_dotenv），寫進去等於沒寫。現由 src/env.py 在 main.py 最前面
# 載入，兩種寫法都認：`KEY=VALUE` 與 `export KEY="VALUE"`。
# 已存在的環境變數不會被覆寫——CI／容器／AgentCore Runtime 注入的值優先。

# ---------------------------------------------------------------------------
# Bedrock
# ---------------------------------------------------------------------------

AWS_REGION=us-west-2

# 留空時用 src/models.py 的 DEFAULT_BEDROCK_MODEL_ID。
# [2026-08-01] 實測 us-west-2 可用（WSParticipantRole）：
#   global.anthropic.claude-sonnet-4-5-20250929-v1:0   ← 預設
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   us.anthropic.claude-haiku-4-5-20251001-v1:0        ← 想省成本/降延遲時用
# 注意 anthropic.claude-3-5-sonnet-20241022-v2:0 已 end-of-life，呼叫會直接失敗。
BEDROCK_MODEL_ID=

# 留空 = 不建 Knowledge Base，SOP 檢索走 src/bedrock_service/local_fallback.py
# 的本機關鍵字比對（retrieval_source="local_fallback"）。這是完全可用的路徑，
# 不是降級失敗。留空時不會送出 KB 請求（見 sop_retriever.query_sop）。
BEDROCK_KNOWLEDGE_BASE_ID=

# 保底模式總開關（00-tech-stack.md §6）。false = 完全不呼叫 LLM：
# A2 改走靜態分派表、W1 只回本機 SOP、C1-C4 用固定模板、M4B 回原始紀錄。
# 決定性模組（規則／路網／ETE）照常運作，黃金值不受影響。
USE_BEDROCK=true

# ---------------------------------------------------------------------------
# 開發期輔助
# ---------------------------------------------------------------------------

# 不在 00-tech-stack.md 原始清單，但 m5-api-orchestrator-dashboard/design.md
# 第2節「開發初期的stub介接」明確用到，一併記錄。
USE_STUB_MODULES=false

# ---------------------------------------------------------------------------
# 僅腳本使用（主流程不讀）
# ---------------------------------------------------------------------------

# scripts/upload_data_to_s3.py 與 scripts/upload_sop_to_s3.py 用。
# 不建 Knowledge Base 就不需要設。
S3_DATA_BUCKET=

# [2026-08-01 盤點] 全 repo 零引用。保留在清單裡是因為 00-tech-stack.md §5 有列，
# 但目前沒有任何程式讀它——決策軌跡存在行程記憶體（src/decision_trace.py），
# 沒有寫進 DynamoDB。要移除請先改 steering 文件。
DECISION_LOG_TABLE=

# ---------------------------------------------------------------------------
# AWS 憑證
# ---------------------------------------------------------------------------
#
# 00-tech-stack.md §5：「AWS 憑證由個人環境提供，不得寫入此檔案或 Git」。
#
# 建議用 `aws configure` / SSO 放進 ~/.aws/credentials，boto3 會自動找到。
# 若使用工作坊的臨時憑證（ASIA... + SessionToken），寫進 .env 也可以——
# .env 已被 .gitignore 排除，但請注意：
#   1. 臨時憑證會過期（通常數小時），過期後所有 LLM 路徑會自動降級，
#      用 `aws sts get-caller-identity` 確認是否還有效。
#   2. 不要把 .env 貼進聊天工具、issue 或截圖。
#
# export AWS_ACCESS_KEY_ID="..."
# export AWS_SECRET_ACCESS_KEY="..."
# export AWS_SESSION_TOKEN="..."

    "WhatIfRequest": { "$comment": "見 src/models.py WhatIfRequest" },
    "WhatIfResult": { "$comment": "見 src/models.py WhatIfResult" },
    "TraceAnswer": { "$comment": "見 src/models.py TraceAnswer" },
    "Notification": { "$comment": "見 src/models.py Notification" },
